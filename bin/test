#!/usr/bin/env python3
"""git status に出る変更が依存するテストだけを実行する。

テストの依存は、テスト本文に書かれた assets/ modules/ bin/ ledger/ print/ の path
(前方一致) と、そこから SCAD の use/include/import を辿った先、テストが import する
tests/ の共通処理、テスト自身から求める。bin/check (台帳の整合検査) は毎回実行する。

  bin/test [--list] [--all] [root]
    --list  実行せずに選んだコマンドを表示する
    --all   変更に関係なく全テストを実行する
"""

from pathlib import Path
import re
import subprocess
import sys

REF = re.compile(r"((?:assets|modules|bin|ledger|print)/[\w./-]*)")
SCAD_DEP = re.compile(r'(?:use|include)\s*<([^>]+)>|import\s*\(\s*"([^"]+)"')
PY_IMPORT = re.compile(r"^\s*(?:from|import)\s+(\w+)", re.M)


def changed_paths(root):
    out = subprocess.run(["git", "-C", str(root), "status", "--porcelain=v1", "-z", "-uall"],
                         capture_output=True, text=True, check=True).stdout
    entries, paths = out.split("\0"), []
    while entries:
        entry = entries.pop(0)
        if not entry:
            continue
        paths.append(entry[3:])
        if entry[0] in "RC":  # rename/copy は元の path が次の要素に続く
            paths.append(entries.pop(0))
    return paths


def scad_deps(root, path, seen):
    file = root / path
    if path in seen or not file.is_file() or file.suffix != ".scad":
        return
    seen.add(path)
    for use, imported in SCAD_DEP.findall(file.read_text(errors="replace")):
        dep = (file.parent / (use or imported)).resolve()
        if dep.is_relative_to(root):
            scad_deps(root, dep.relative_to(root).as_posix(), seen)
            seen.add(dep.relative_to(root).as_posix())


def test_files(root):
    return sorted(p for p in (root / "tests").iterdir()
                  if p.suffix in (".py", ".sh") and p.read_text(errors="replace").startswith("#!"))


def dependencies(root, test):
    text = test.read_text(errors="replace")
    prefixes = {test.relative_to(root).as_posix(), *REF.findall(text)}
    prefixes |= {f"tests/{m}.py" for m in PY_IMPORT.findall(text) if (root / "tests" / f"{m}.py").is_file()}
    seen = set()
    for ref in [p for p in prefixes if p.startswith(("assets/", "modules/"))]:
        base = root / ref
        for scad in ([base] if base.is_file() else base.rglob("*.scad") if base.is_dir() else []):
            scad_deps(root, scad.relative_to(root).as_posix(), seen)
    return prefixes | seen


def command(root, test):
    rel = test.relative_to(root).as_posix()
    return f"python3 {rel}" if test.suffix == ".py" else rel


def select(root, run_all):
    changed = changed_paths(root)
    return ["bin/check"] + [command(root, t) for t in test_files(root)
                            if run_all or any(c.startswith(d) for d in dependencies(root, t) for c in changed)]


def main(args):
    listing, run_all = "--list" in args, "--all" in args
    rest = [a for a in args if a not in ("--list", "--all")]
    root = Path(rest[0] if rest else Path(__file__).resolve().parents[1]).resolve()
    commands = select(root, run_all)
    if listing:
        print("\n".join(commands))
        return 0
    failed = []
    for cmd in commands:
        print(f"==> {cmd}", flush=True)
        if subprocess.run(cmd.split(), cwd=root).returncode != 0:
            failed.append(cmd)
    if failed:
        print("FAILED: " + ", ".join(failed), file=sys.stderr)
        return 1
    print(f"{len(commands)} passed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
