#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
ENV_FILE="$CONFIG_HOME/scad-live/.env"
UNIT_DIR="$CONFIG_HOME/systemd/user"
SYSTEMCTL=${SYSTEMCTL:-systemctl}

if [ ! -f "$ENV_FILE" ] ||
   [ ! -f "$UNIT_DIR/scad-live-watch.service" ] ||
   [ ! -f "$UNIT_DIR/scad-live-server.service" ]; then
  echo 'scad-live is not set up. Follow the "scad-live" install steps in the' >&2
  echo 'home-server repository, systemd/README.md, first.' >&2
  exit 1
fi

for path in "$PROJECT_ROOT/src/projects" "$PROJECT_ROOT/src/modules" "$PROJECT_ROOT/dist"; do
  if [[ "$path" == *'"'* || "$path" == *\\* || "$path" == *$'\n'* ]]; then
    echo "unsupported character in project path: $path" >&2
    exit 1
  fi
done

tmp=$(mktemp "$CONFIG_HOME/scad-live/.env.new.XXXXXX")
previous=$(mktemp "$CONFIG_HOME/scad-live/.env.previous.XXXXXX")
cleanup() {
  rm -f "$tmp" "$previous"
}
trap cleanup EXIT
cp -p "$ENV_FILE" "$previous"

awk \
  -v src="$PROJECT_ROOT/src/projects" \
  -v modules="$PROJECT_ROOT/src/modules" \
  -v dist="$PROJECT_ROOT/dist" '
  /^SCAD_LIVE_SRC=/ {
    print "SCAD_LIVE_SRC=\"" src "\""
    found_src = 1
    next
  }
  /^SCAD_LIVE_MODULES=/ {
    print "SCAD_LIVE_MODULES=\"" modules "\""
    found_modules = 1
    next
  }
  /^SCAD_LIVE_DIST=/ {
    print "SCAD_LIVE_DIST=\"" dist "\""
    found_dist = 1
    next
  }
  { print }
  END {
    if (!found_src) print "SCAD_LIVE_SRC=\"" src "\""
    if (!found_modules) print "SCAD_LIVE_MODULES=\"" modules "\""
    if (!found_dist) print "SCAD_LIVE_DIST=\"" dist "\""
  }
' "$ENV_FILE" > "$tmp"
chmod --reference="$ENV_FILE" "$tmp"
mv -f "$tmp" "$ENV_FILE"

if ! "$SYSTEMCTL" --user restart scad-live-watch scad-live-server; then
  mv -f "$previous" "$ENV_FILE"
  "$SYSTEMCTL" --user restart scad-live-watch scad-live-server || true
  echo 'scad-live restart failed; restored the previous configuration' >&2
  exit 1
fi

echo "scad-live now uses $PROJECT_ROOT"
