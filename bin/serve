#!/usr/bin/env node

import fs from 'fs';
import http from 'http';
import path from 'path';
import { fileURLToPath } from 'url';
import { watch } from 'chokidar';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.resolve(__dirname, '..');
const distDir = path.join(projectRoot, 'dist');
const viewerDir = path.join(projectRoot, 'src', 'viewer');

const vendorFiles = new Map([
  ['three.module.js', 'node_modules/three/build/three.module.js'],
  ['three.core.js', 'node_modules/three/build/three.core.js'],
  [
    'examples/jsm/loaders/STLLoader.js',
    'node_modules/three/examples/jsm/loaders/STLLoader.js',
  ],
  [
    'examples/jsm/controls/OrbitControls.js',
    'node_modules/three/examples/jsm/controls/OrbitControls.js',
  ],
]);

const portValue = process.env.PORT ?? process.argv[2] ?? '8080';
const port = Number(portValue);
if (!Number.isInteger(port) || port < 0 || port > 65535) {
  console.error(`Invalid port: ${portValue}`);
  process.exit(1);
}

const clients = new Set();

function send(response, status, headers, body = '') {
  response.writeHead(status, {
    'Cache-Control': 'no-store',
    ...headers,
  });
  response.end(body);
}

function sendFile(response, filePath, contentType) {
  const stream = fs.createReadStream(filePath);
  stream.on('open', () => {
    response.writeHead(200, {
      'Cache-Control': 'no-store',
      'Content-Type': contentType,
    });
    stream.pipe(response);
  });
  stream.on('error', (error) => {
    if (!response.headersSent) {
      send(
        response,
        error.code === 'ENOENT' ? 404 : 500,
        { 'Content-Type': 'text/plain; charset=utf-8' },
        error.code === 'ENOENT' ? 'Not found\n' : 'Internal server error\n',
      );
    } else {
      response.destroy(error);
    }
  });
}

function listModels(dir = distDir, prefix = '') {
  if (!fs.existsSync(dir)) return [];

  return fs
    .readdirSync(dir, { withFileTypes: true })
    .flatMap((entry) => {
      const relativePath = prefix ? `${prefix}/${entry.name}` : entry.name;
      if (entry.isDirectory()) {
        return listModels(path.join(dir, entry.name), relativePath);
      }
      return entry.isFile() && entry.name.toLowerCase().endsWith('.stl')
        ? [relativePath]
        : [];
    })
    .sort((a, b) => a.localeCompare(b));
}

function sendModel(response, rawPathname) {
  let relativePath;
  try {
    relativePath = decodeURIComponent(rawPathname.slice('/models/'.length));
  } catch {
    send(
      response,
      400,
      { 'Content-Type': 'text/plain; charset=utf-8' },
      'Bad request\n',
    );
    return;
  }

  const filePath = path.resolve(distDir, relativePath);
  const isInsideDist = filePath.startsWith(`${distDir}${path.sep}`);
  if (!isInsideDist || path.extname(filePath).toLowerCase() !== '.stl') {
    send(
      response,
      403,
      { 'Content-Type': 'text/plain; charset=utf-8' },
      'Forbidden\n',
    );
    return;
  }

  sendFile(response, filePath, 'model/stl');
}

function sendEvents(request, response) {
  response.writeHead(200, {
    'Cache-Control': 'no-store',
    Connection: 'keep-alive',
    'Content-Type': 'text/event-stream',
  });
  response.write(': connected\n\n');
  clients.add(response);

  request.on('close', () => clients.delete(response));
}

const server = http.createServer((request, response) => {
  if (request.method !== 'GET') {
    send(
      response,
      405,
      { Allow: 'GET', 'Content-Type': 'text/plain; charset=utf-8' },
      'Method not allowed\n',
    );
    return;
  }

  const rawPathname = request.url.split('?', 1)[0];

  if (rawPathname.startsWith('/models/')) {
    sendModel(response, rawPathname);
    return;
  }

  let pathname;
  try {
    pathname = new URL(request.url, 'http://localhost').pathname;
  } catch {
    send(
      response,
      400,
      { 'Content-Type': 'text/plain; charset=utf-8' },
      'Bad request\n',
    );
    return;
  }

  if (pathname === '/') {
    sendFile(
      response,
      path.join(viewerDir, 'index.html'),
      'text/html; charset=utf-8',
    );
  } else if (pathname === '/main.js') {
    sendFile(
      response,
      path.join(viewerDir, 'main.js'),
      'text/javascript; charset=utf-8',
    );
  } else if (pathname === '/api/models') {
    send(
      response,
      200,
      { 'Content-Type': 'application/json; charset=utf-8' },
      JSON.stringify(listModels()),
    );
  } else if (pathname === '/events') {
    sendEvents(request, response);
  } else if (pathname.startsWith('/vendor/')) {
    const vendorPath = pathname.slice('/vendor/'.length);
    const relativePath = vendorFiles.get(vendorPath);
    if (!relativePath) {
      send(
        response,
        404,
        { 'Content-Type': 'text/plain; charset=utf-8' },
        'Not found\n',
      );
      return;
    }
    sendFile(
      response,
      path.join(projectRoot, relativePath),
      'text/javascript; charset=utf-8',
    );
  } else {
    send(
      response,
      404,
      { 'Content-Type': 'text/plain; charset=utf-8' },
      'Not found\n',
    );
  }
});

const watcher = watch(distDir, {
  ignoreInitial: true,
  awaitWriteFinish: {
    stabilityThreshold: 300,
    pollInterval: 100,
  },
});

for (const eventType of ['add', 'change', 'unlink']) {
  watcher.on(eventType, (filePath) => {
    if (!filePath.toLowerCase().endsWith('.stl')) return;
    const message = JSON.stringify({
      type: eventType,
      file: path.relative(distDir, filePath).split(path.sep).join('/'),
    });
    for (const client of clients) client.write(`data: ${message}\n\n`);
  });
}

const keepalive = setInterval(() => {
  for (const client of clients) client.write(': ping\n\n');
}, 30_000);

server.listen(port, '0.0.0.0', () => {
  const address = server.address();
  console.log(`STL viewer listening on http://0.0.0.0:${address.port}`);
});

async function shutdown() {
  clearInterval(keepalive);
  for (const client of clients) client.end();
  await watcher.close();
  server.close();
}

process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);
